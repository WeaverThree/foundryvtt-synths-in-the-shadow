<div class="{{cssClass}} clock-block" autocomplete="off">
  <div class="clock-header">
    <div class="clock-name">
      <input type="text" id="{{id}}-clock-name" name="name" value="{{name}}" {{#unless editable}}disabled{{/unless}} />
    </div>
    {{#if editable}}
      <label for="system.type"><i class="fa fa-chart-pie"></i></label>
      <select data-type="String" name="system.type">
        {{selectOptions sizeDropdown selected=system.type}}

      </select>
      
      <label for="system.color"><i class="fa fa-palette"></i></label>
      <select data-type="String" name="system.color">
        {{selectOptions colorDropdown selected=system.color localize=true}}

      </select>
    {{/if}}
  </div>
  <div class="clocks clocks-{{system.type}}">
    {{{sits-clock-color "system.value" system.type system.color system.value _id}}}
  </div>
  <textarea type="text" id="agent-{{_id}}-description" class="description-field" name="system.description" placeholder="[{{localize 'SITS.ClockDescriptionPlaceholder'}}]" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea>

</div>