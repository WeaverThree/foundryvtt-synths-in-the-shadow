<div class="{{cssClass}} agent-sheet" autocomplete="off">

  <section id="agent-{{_id}}-header" class="flex-horizontal marginize-divs">

    <div class="portrait-area">
      <img src="{{img}}" {{#if editable}}data-action="editImage"{{/if}} data-edit="img" class="portrait" />
      <div class="underportrait">

        {{#if editable}}<a data-action="itemAddPopup" data-distinct="false" data-item-type="unit">{{/if}}
          <div class="unit underportrait-line">
            <div class="box-title"><b>{{localize 'SITS.Unit'}}</b></div>
            {{system.unit.name}}
            </div>
        {{#if editable}}</a>{{/if}}

        {{#if editable}}<a data-action="itemAddPopup" data-distinct="true" data-item-type="playbook">{{/if}}
          <div class="playbook underportrait-line">
            <div class="box-title"><b>{{localize 'SITS.Playbook'}}</b></div>
              {{#each items as |item id|}} {{#if (eq item.type "playbook")}}
                {{item.name}}
              {{/if}} {{/each}}
          </div>
        {{#if editable}}</a>{{/if}}

      </div>
    </div>

    <div id="description"> {{!-- MARK: Description --}}

      <div class="headline">
        <div class="headline-left">
          <input type="text" id="agent-{{_id}}-model" class="model" name="system.model" value="{{system.model}}" placeholder="[{{localize 'SITS.Model'}}]" {{#unless editable}}disabled{{/unless}}>
          <input type="text" id="agent-{{_id}}-pronouns" class="pronouns" name="system.pronouns" value="{{system.pronouns}}" placeholder="[{{localize 'SITS.Pronouns'}}]" {{#unless editable}}disabled{{/unless}}>
        </div>
        <input type="text" id="agent-{{_id}}-name" class="name" name="name" value="{{name}}" {{#unless editable}}disabled{{/unless}}>
      </div>
      <div class="lookline">
        <input type="text" id="agent-{{_id}}-look" class="look" name="system.look" value="{{system.look}}" placeholder="[{{localize 'SITS.LookPlaceholder'}}]" {{#unless editable}}disabled{{/unless}}>
      </div>

      <div id="agent-{{_id}}-traits" class="flex-column">

        <div class="traitsline">

          {{#if editable}}<a data-action="itemAddPopup" data-distinct="true" data-item-type="maker">{{/if}}
            <div class="maker">
              <span class="box-title">{{localize "SITS.Maker"}}</span>
                <div class="fakeinput">
                  {{#each items as |item id|}} {{#if (eq item.type "maker")}}
                    {{item.name}}
                  {{/if}} {{/each}}
                </div>
            </div>
          {{#if editable}}</a>{{/if}}

          <div class="maker-detail detail">
            <span class="box-title">{{localize "SITS.Detail"}}</span>
            <input type="text" id="agent-{{_id}}-maker_details" class="maker_details" name="system.maker_details" value="{{system.maker_details}}" {{#unless editable}}disabled{{/unless}}>
          </div>

        </div>
        
        <div class="traitsline">
          <div class="build">
            {{#if editable}}<a data-action="itemAddPopup" data-distinct="true" data-item-type="build">{{/if}}
              <span class="box-title">{{localize "SITS.Build"}}</span>
              <div class="fakeinput">
                {{#each items as |item id|}} {{#if (eq item.type "build")}}
                  {{item.name}}
                {{/if}} {{/each}}
              </div>
            {{#if editable}}</a>{{/if}}
          </div>
          
          <div class="build-detail detail">
            <span class="box-title">{{localize "SITS.Detail"}}</span>
            <input type="text" id="agent-{{_id}}-build_details" class="build_details" name="system.build_details" value="{{system.build_details}}" {{#unless editable}}disabled{{/unless}}>
          </div>
        </div>

        <div class="traitsline">
          <div class="deviance">
            {{#if editable}}<a data-action="itemAddPopup" data-distinct="true" data-item-type="deviance">{{/if}}
              <span class="box-title">{{localize "SITS.Deviance"}}</span>
              <div class="fakeinput">
                {{#each items as |item id|}} {{#if (eq item.type "deviance")}}
                  {{item.name}}
                {{/if}} {{/each}}
              </div>
            {{#if editable}}</a>{{/if}}
          </div>
          
          <div class="deviance-detail detail">
            <span class="box-title">{{localize "SITS.Detail"}}</span>
            <input type="text" id="agent-{{_id}}-deviance_details" class="deviance_details" name="system.deviance_details" value="{{system.deviance_details}}" {{#unless editable}}disabled{{/unless}}>
          </div>
        </div>

      </div>
    </div> {{!-- end description --}}

  </section>

  <section class="flex-horizontal">
    <textarea type="text" id="agent-{{_id}}-synopsis" class="synopsis" name="system.synopsis" placeholder="[{{localize 'SITS.SynopsisPlaceholder'}}]" {{#unless editable}}disabled{{/unless}}>{{system.synopsis}}</textarea>
  </section>

  <section class="flex-horizontal second-section marginize-divs">

    {{!-- MARK: OVER/MAL/COIN --}}
    <div id="agent-{{_id}}-overload-malfunction" class="section overload-malfunction">
    
      <div id="agent-{{_id}}-overload" class="overload {{#unless editable}}disabled{{/unless}}">
        {{#multiboxes system.overload.value}}

          <input type="radio" id="agent-{{_id}}-overload-0" name="system.overload.value" value="0" dtype="Radio">
          <div class="black-label">{{localize "SITS.Overload"}}</div>

          {{#times_from 1 system.overload.max}}
            <input type="radio" id="agent-{{../_id}}-overload-{{this}}" name="system.overload.value" value="{{this}}" dtype="Radio">
            <label data-action="radioToggle" for="agent-{{../_id}}-overload-{{this}}"></label>
          {{/times_from}}

        {{/multiboxes}}
      </div>

      {{#if editiable}}<a data-action="itemAddPopup" data-item-type="malfunction" data-tooltip="{{localize 'SITS.AddMalfunction'}}">{{/if}}
        <div id="agent-{{_id}}-malfunction-container" class="malfunction">
          {{#malfunctioncounter items}}

            <div class="black-label">{{localize 'SITS.Malfunction'}}</div>
            <input type="radio" id="agent-{{_id}}-malfunction-counter-0" name="system.malfunction.value" value="0">

            {{#times_from 1 system.malfunction.max}}
              <input type="radio" id="agent-{{../_id}}-malfunction-counter-{{this}}" name="system.malfunction.value" value="{{this}}" disabled>
              <label for="agent-{{../_id}}-malfunction-counter-{{this}}"></label>
            {{/times_from}}
            
          {{/malfunctioncounter}}
        </div>
      {{#if editiable}}</a>{{/if}}

      <div class="energy_credits-header">
        <div>{{localize "SITS.Energy Credits"}}</div>
        <div>{{localize "SITS.Savings"}}</div>
      </div>

      <div id="agent-{{_id}}-energy_credits" class="energy_credits {{#unless editable}}disabled{{/unless}}">

        <div id="agent-{{_id}}-on_hand" class="on_hand energy_credits-pips">
          {{#multiboxes system.energy_credits.on_hand}}
            <input type="radio" id="energy_credits-{{_id}}-on_hand-0" name="system.energy_credits.on_hand" value="0" checked="checked">
            {{#times_from 1 system.energy_credits.max_hand}}
              <input type="radio" id="energy_credits-{{../_id}}-on_hand-{{this}}" name="system.energy_credits.on_hand" value="{{this}}">
              <label data-action="radioToggle" for="energy_credits-{{../_id}}-on_hand-{{this}}"></label>
            {{/times_from}}
          {{/multiboxes}}
        </div>

        <div id="energy_credits-{{_id}}-energy_credits-savings" class="savings energy_credits-pips">
          {{#multiboxes system.energy_credits.savings}}
            <input type="radio" id="energy_credits-{{_id}}-savings-0" name="system.energy_credits.savings" value="0" checked="checked">
            {{#times_from 1 system.energy_credits.max_stash}}
              <input type="radio" id="energy_credits-{{../_id}}-savings-{{this}}" name="system.energy_credits.savings" value="{{this}}">
              <label data-action="radioToggle" for="energy_credits-{{../_id}}-savings-{{this}}"></label>
            {{/times_from}}
          {{/multiboxes}} 
        </div>

      </div>

    </div> {{!-- End Overload/Malfunction/Coins --}}

    {{!-- MARK: Attributes --}}
    <div id="agent-{{_id}}-attributes" class="attributes {{#unless editable}}disabled{{/unless}}">

      {{#each system.attributes as |attribute attribute_name|}}
        
        <div id="agent-{{../_id}}-attributes-{{attribute_name}}" class="attribute">
        
          <div id="agent-{{../_id}}-attributes-{{attribute_name}}-title" class="attributes-exp">
            <div class="stripe">
              <a class="attribute-label rollable-text" data-action="rollAttribute" data-roll-attribute="{{attribute_name}}">
                {{localize attribute.label}}
              </a>
            </div>
            <div class="experience-pips">
              {{#multiboxes attribute.exp}}
                <input type="radio" id="{{../_id}}-{{attribute_name}}-exp-0"
                        name="system.attributes.{{attribute_name}}.exp" value="0" checked="checked">
                {{#times_from 1 attribute.exp_max}}
                  <input type="radio" id="{{../../_id}}-{{attribute_name}}-exp-{{this}}"
                          name="system.attributes.{{attribute_name}}.exp" value="{{this}}">
                  <label data-action="radioToggle" for="{{../../_id}}-{{attribute_name}}-exp-{{this}}"></label>
                {{/times_from}}
              {{/multiboxes}}
            </div>
          </div>
    

          {{!-- Skills --}}
          {{#each attribute.skills as |skill skill_name|}}

            <div class="flex-horizontal">
              <div class="attributes-container">
                {{#multiboxes skill.value}}
                  <input {{#if (lteq 0 (oneless skill.min))}}disabled {{/if}}
                          type="radio" id="attributes-{{../../../_id}}-{{skill_name}}-0" data-dtype="Number"
                          name="system.attributes.{{attribute_name}}.skills.{{skill_name}}.value" value="0">
                  {{#times_from 1 skill.max}}
                    <input {{#if (lteq this (oneless skill.min))}}disabled {{/if}}
                            type="radio" id="attributes-{{../../../_id}}-{{skill_name}}-{{this}}" data-dtype="Number"
                            name="system.attributes.{{attribute_name}}.skills.{{skill_name}}.value" value="{{this}}">
                    <label {{#if (and (gt skill.min 0) (lteq this skill.min))}} data-tooltip="{{localize "BITD.DisabledByAE"}}"{{/if}}
                            {{#if (lteq this (oneless skill.min))}} style="filter: unset; opacity: unset; cursor: unset;"{{/if}}
                            data-action="radioToggle" for="attributes-{{../../../_id}}-{{skill_name}}-{{this}}"></label>
                  {{/times_from}}
            
                  {{#if (eq skill.max 3)}}
                    <input type="radio" id="attributes-{{../../../_id}}-{{skill_name}}-{{this}}" data-dtype="Number"
                            name="system.attributes.{{attribute_name}}.skills.{{skill_name}}.value" value="{{this}}">
                    <label data-tooltip="{{localize "BITD.NoMastery"}}" class="no-mastery"></label>
                  {{/if}}

                  <div class="attribute-skill-label rollable-text" data-action="rollAttribute" data-roll-attribute="{{skill_name}}">
                    {{localize skill.label}}
                  </div>
                {{/multiboxes}}
              </div>
            </div>
          {{/each}} {{!-- End each skill --}}
        </div>
      {{/each}} {{!-- End each attribute --}}
    </div>

  </section>


  {{!-- MARK: Damage, Repair and Armor --}}
  <section id="agent-{{_id}}-damage-armor" class="flex third-section">
    <div id="agent-{{_id}}-agent-damage" class="flex-horizontal damage-armor">
      <table>
        <thead>
          <th colspan="4">{{localize "SITS.Damage"}}</th>
          <th>{{localize "SITS.Repair"}}</th>
          <th>{{localize "SITS.Armor"}}</th>
        </thead>
        <tbody>
          <tr>
            <td>3</td>
            <td colspan="2">
              <input type="text" id="agent-{{_id}}-damage-3-1" name="system.damage.heavy.one" value="{{system.damage.heavy.one}}" {{#unless editable}}disabled{{/unless}}>
            </td>
            <td>{{localize "SITS.MoreEffect"}}</td>
            <td rowspan="3">
              <div id="agent-{{_id}}-repair_clock" class="flex-horizontal-center repair_clock clocks-{{system.repair_clock.max}} {{#unless editable}}disabled{{/unless}}">
                {{{sits-clock-color "system.repair_clock.value" system.repair_clock.max "blue" system.repair_clock.value _id}}}
              </div>
            </td>
            <td rowspan="3" id="agent-{{_id}}-armor_uses" class="armor_uses">
              <div {{#unless editable}}class="disabled"{{/unless}}>
                {{localize "SITS.Basic"}}
                <input id="agent-{{_id}}-armor_uses-basic" type="checkbox" name="system.armor_uses.basic" class="check" {{checked system.armor_uses.basic}}>
                <label for="agent-{{_id}}-armor_uses-basic" data-action="radioToggleSingle"></label>
              </div>
              <div {{#unless editable}}class="disabled"{{/unless}}>
                {{localize "SITS.Heavy"}}
                <input id="agent-{{_id}}-armor_uses-heavy" type="checkbox" name="system.armor_uses.heavy" class="check" {{checked system.armor_uses.heavy}}>
                <label for="agent-{{_id}}-armor_uses-heavy" data-action="radioToggleSingle"></label>
              </div>
              <div {{#unless editable}}class="disabled"{{/unless}}>
                {{localize "SITS.Special"}}
                <input id="agent-{{_id}}-armor_uses-special" type="checkbox" name="system.armor_uses.special" class="check" {{checked system.armor_uses.special}}>
                <label for="agent-{{_id}}-armor_uses-special" data-action="radioToggleSingle"></label>
              </div>
            </td>
          </tr>
          <tr>
            <td>2</td>
            <td>
              <input type="text" id="agent-{{_id}}-damage-2-1" name="system.damage.medium.one" value="{{system.damage.medium.one}}" {{#unless editable}}disabled{{/unless}}>
            </td>
            <td>
              <input type="text" id="agent-{{_id}}-damage-2-2" name="system.damage.medium.two" value="{{system.damage.medium.two}}" {{#unless editable}}disabled{{/unless}}>
            </td>
            <td>{{localize "SITS.PlusOneDie"}}</td>
          </tr>
          <tr>
            <td>1</td>
            <td>
              <input type="text" id="agent-{{_id}}-damage-1-1" name="system.damage.light.one" value="{{system.damage.light.one}}" {{#unless editable}}disabled{{/unless}}>
            </td>
            <td>
              <input type="text" id="agent-{{_id}}-damage-1-2" name="system.damage.light.two" value="{{system.damage.light.two}}" {{#unless editable}}disabled{{/unless}}>
            </td>
            <td></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>


  {{!-- MARK: Tabbed Section --}}
  <section class="flex-horizontal">

    <div class="tab-content flex-vertical grow-one">

      {{!-- Nav menu --}}
      <nav class="main-tabs tabs flex-horizontal">
        <div id="actor-{{_id}}-playbook_xp" class="experience-pips {{#unless editable}}disabled{{/unless}}">
          {{#multiboxes system.playbook_xp.value}}
            <input type="radio" id="agent-{{_id}}-playbook_xp-0" name="system.playbook_xp.value" value="0" dtype="Radio">
            {{#times_from 1 system.playbook_xp.max}}
              <input type="radio" id="agent-{{_id}}-playbook_xp-{{this}}" name="system.playbook_xp.value" value="{{this}}" dtype="Radio">
              <label data-action="radioToggle" for="agent-{{_id}}-playbook_xp-{{this}}"></label>
            {{/times_from}}
          {{/multiboxes}}
        </div>
        {{#each tabs as |tab|}}
          <a class="{{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">
            <label>{{localize tab.label}}</label>
          </a>
        {{/each}}
      </nav>

      <section class="content">

      {{!-- MARK: Abilities --}}

        <div id="actor-{{_id}}-abilities" class="tab tab-mainpage {{tabs.mainpage.cssClass}} flex-horizontal" data-group="main" data-tab="mainpage">
          <div class="flex-horizontal">
            <div class="abilities grow-one">
              <table>
                {{#unless anyAbilities}}
                  <tr>
                    <td class="add-playbook {{#unless editable}}disabled{{/unless}}" colspan="3">
                      <a data-action="itemAddPopup" data-distinct="true" data-item-type="playbook">{{{localize 'SITS.AbilitiesAddPlaybook'}}}</a>
                    </td>
                  </tr>
                {{/unless}}
                {{#each sortedAbilities as |item id|}}
                  <tr>
                    <td class="checks {{#unless ../editable}}disabled{{/unless}}">
                      <div>
                        {{#multiboxes item.system.purchased.value}}
                          <input type="radio" id="ability-{{_id}}-{{../_id}}-0" name="{{_id}}-system.purchased.value" value="0" checked="checked">
                          {{#times_from 1 item.system.purchased.max}}
                            <input type="radio" id="ability-{{../_id}}-{{../../_id}}-{{this}}" name="{{../_id}}-system.purchased.value" value="{{this}}">
                            <label data-action="radioAbility" for="ability-{{../_id}}-{{../../_id}}-{{this}}"></label>
                          {{/times_from}}
                        {{/multiboxes}}               
                      </div>
                    </td>
                    <td class="ability-title">
                      <a data-action="openItem" data-target="{{item.id}}">
                        {{item.name}}
                      </a>
                    </td>
                    <td class="ability-description">
                      {{#if item.system.use_target}}
                        <div class="ability-target {{#unless ../editable}}disabled{{/unless}}">
                          <input type="text" class="input-to-item" id="ability-{{_id}}-{{../_id}}-target" name="{{_id}}-system.target" value="{{item.system.target}}">
                        </div>
                      {{/if}}
                      {{{item.system.description}}}
                    </td>
                  </tr>
                {{/each}}
                <tr>
                  {{#if editable}}
                    <td class="add-ability" colspan="3">
                      <a data-action="itemAddPopup" data-distinct="false" data-item-type="ability">{{{localize 'SITS.AddAbility'}}}</a>
                    </td>
                  {{/if}}
                </tr>
              </table>
            </div>

            {{!-- MARK: Loadout/Contacts --}}
            <div class="loadout grow-one">
              <div class="label-stripe {{#unless editable}}disabled{{/unless}}"> 
                <select name="system.capacity.selected" id="capacity-selection-{{_id}}">
                  <option value="{{system.capacity.selected}}">{{system.capacity.selected}}</option>
                  <option value="light">Light</option>
                  <option value="normal">Normal</option>
                  <option value="heavy">Heavy</option>
                </select>
                {{localize 'SITS.LoadoutCapacity'}}

                <div id="agent-{{_id}}-capacity-pips" class="capacity-pips disabled">
                  {{#multiboxes system.capacity.value}}
                    <input type="radio" id="capacity-{{_id}}-0" name="system.capacity.value" value="0" checked="checked">
                    {{#times_from 1 system.capacity.max}}
                      <input type="radio" id="capacity-{{../_id}}-on_hand-{{this}}" name="system.capacity.value" value="{{this}}">
                      <label class="radio-toggle" for="capacity-{{../_id}}-on_hand-{{this}}"></label>
                    {{/times_from}}
                    {{#times_from capacityMaxPlusOne system.capacity.value}}
                      <input type="radio" id="capacity-{{../_id}}-on_hand-{{this}}" name="system.capacity.value" value="{{this}}">
                      <label class="radio-toggle overload" for="capacity-{{../_id}}-on_hand-{{this}}"></label>
                    {{/times_from}}
                  {{/multiboxes}}
                </div>

              </div>
              <div class="flex-horizontal">
                <div class="loadout-contacts">
                  <div class="loadout-playbook grow-one"> 
                    {{#each sortedPlaybookItems as |item id|}}
                      <div class="itemline cap-{{item.system.capacity}}">
                        <div class="checks {{#unless ../editable}}disabled{{/unless}}">
                          <input type="checkbox" id="item-inplay-{{_id}}-{{../_id}}-1" name="{{_id}}-system.inplay" class="check-item" {{checked item.system.inplay}}>
                          <label data-action="checkItem" for="item-inplay-{{_id}}-{{../_id}}-1"></label>
                          {{#times_from 2 item.system.capacity}}
                            <input type="checkbox" id="item-inplay-{{../_id}}-{{../../_id}}-{{this}}" name="{{../_id}}-system.inplay" class="check-item" {{checked item.system.inplay}}>
                            <label data-action="checkItem" for="item-inplay-{{../_id}}-{{../../_id}}-{{this}}"></label>
                          {{/times_from}}
                        </div>
                        <div>
                          <a data-action="openItem" data-target="{{item.id}}">
                            {{item.name}}
                          </a>
                        </div>
                      </div>
                    {{/each}}
                    {{#each sortedOtherPlaybookItems as |item id|}}
                      <div class="itemline cap-{{item.system.capacity}}">
                        <div class="checks {{#unless ../editable}}disabled{{/unless}}">
                          <input type="checkbox" id="item-inplay-{{_id}}-{{../_id}}-1" name="{{_id}}-system.inplay" class="check-item" {{checked item.system.inplay}}>
                          <label data-action="checkItem" for="item-inplay-{{_id}}-{{../_id}}-1"></label>
                          {{#times_from 2 item.system.capacity}}
                            <input type="checkbox" id="item-inplay-{{../_id}}-{{../../_id}}-{{this}}" name="{{../_id}}-system.inplay" class="check-item" {{checked item.system.inplay}}>
                            <label data-action="checkItem" for="item-inplay-{{../_id}}-{{../../_id}}-{{this}}"></label>
                          {{/times_from}}
                        </div>
                        <div>
                          <a data-action="openItem" data-target="{{item.id}}">
                            {{item.name}}
                          </a>
                        </div>
                      </div>
                    {{/each}}
                    {{#if editable}}
                      <div class="itemline add-item">
                        <a data-action="itemAddPopup" data-distinct="false" data-item-type="item">{{{localize 'SITS.AddItem'}}}</a>
                      </div>
                    {{/if}}

                  </div>
                  {{!-- Contacts --}}
                  <div class="label-stripe flex-horizontal contacts-header">
                    {{localize "SITS.Contacts"}}
                  </div>
                  <div class="contacts flex-vertical">
                    {{#each sortedContacts as |contact|}}
                      <div class="contact">
                        <label data-action="standingToggle {{#unless ../editable}}disabled{{/unless}}" data-contact="{{contact.id}}" class="standing-toggle
                        {{#if (eq contact.standing 'friend' )}} standing-friend
                        {{else if (eq contact.standing 'rival')}} standing-rival
                        {{else}} standing-neutral
                        {{/if}}"></label>
                        <a data-action="openContact" data-target="{{contact.id}}">{{contact.name}}</a>
                      </div>
                    {{/each}}
                    {{#if editable}}
                      <div class="contact add-contact">
                        <a data-action="itemAddPopup" data-distinct="false" data-item-type="npc">{{{localize 'SITS.AddContact'}}}</a>
                      </div>
                    {{/if}}
                  </div>


                </div>

                <div class="loadout-generic grow-one">
                {{#each sortedGenericItems as |item id|}}
                  <div class="itemline cap-{{item.system.capacity}}">
                    <div class="checks {{#unless ../editable}}disabled{{/unless}}">
                      <input type="checkbox" id="item-inplay-{{_id}}-{{../_id}}-1" name="{{_id}}-system.inplay" class="check-item" {{checked item.system.inplay}}>
                      <label data-action="checkItem" for="item-inplay-{{_id}}-{{../_id}}-1"></label>
                      {{#times_from 2 item.system.capacity}}
                        <input type="checkbox" id="item-inplay-{{../_id}}-{{../../_id}}-{{this}}" name="{{../_id}}-system.inplay" class="check-item" {{checked item.system.inplay}}>
                        <label data-action="checkItem" for="item-inplay-{{../_id}}-{{../../_id}}-{{this}}"></label>
                      {{/times_from}}
                    </div>
                    <div>
                      <a data-action="openItem" data-target="{{item.id}}">
                        {{item.name}}
                      </a>
                    </div>
                  </div>
                {{/each}}
                </div>
              </div>


              {{!-- MARK: XP Triggers --}}
              
              <div class="label-stripe">{{localize 'SITS.ExpHeader'}}</div>
              <div class="xp-triggers">

                <p>{{{localize 'SITS.ExpClue1'}}}</p>
                <p>{{{localize 'SITS.ExpClueDescription'}}}</p>
                {{#each items as |item id|}} {{#if (eq item.type "playbook")}}
                  <p>{{{item.system.experience_clue}}}</p>
                {{/if}} {{/each}}
                <p>{{{localize 'SITS.ExpClue2'}}}</p>
                <p>{{{localize 'SITS.ExpClue3'}}}</p>

              </div>

            </div>
          </div>
        </div>


        {{!-- MARK: Notes --}}
        <div class="tab {{tabs.agentnotes.cssClass}} flex-vertical" data-group="main" data-tab="agentnotes">
          <textarea id="agent-{{_id}}-description" rows="13" name="system.description">{{{system.description}}}</textarea>
        </div>


        {{!-- MARK: Active Effects --}}
        <div id="agent-{{_id}}-effects" class="tab {{tabs.effects.cssClass}} effects flex-vertical" data-group="main" data-tab="effects">
          {{> "systems/synths-in-the-shadow/templates/parts/active-effects.html"}}
        </div>


        {{!-- MARK:Full Item List --}}
        <div class="tab allitems {{tabs.allagentitems.cssClass}} grow-two flex-vertical" data-group="main" data-tab="allagentitems">
          {{#each items as |item id|}}
            <div class="item flex-horizontal" data-item-id="{{item._id}}">
              <div class="item-body item-sheet-open flex-horizontal">
                  <img src="{{item.img}}" data-tooltip="{{item.name}}" width="24" height="24"/>
                  <div class="item-name">
                    <a data-action="openItem" data-target="{{item.id}}">
                      {{item.name}}
                    </a>
                  </div>
              </div>
              <a data-action="deleteItem" data-target="{{item.id}}" data-tooltip="{{localize 'BITD.TitleDeleteItem'}}"><i class="fas fa-trash"></i></a>
            </div>
          {{/each}}
          <div class="subhead-stripe"><label>{{localize "SITS.SpecialItems"}}</label></div>
          {{#each system.contacts as |item|}}
            <div class="item flex-horizontal" data-item-id="{{item._id}}">
              <div class="item-body item-sheet-open flex-horizontal">
                <img src="{{item.img}}" data-tooltip="{{item.name}}" width="24" height="24"/>
                <div class="item-name">
                  <a data-action="openContact" data-target="{{item.id}}">
                    {{item.name}}
                  </a>
                </div>
              </div>
              <a data-action="deleteContact" data-target="{{item.id}}" data-tooltip="{{localize 'BITD.TitleDeleteItem'}}"><i class="fas fa-trash"></i></a>
            </div>
          {{/each}}
          {{#if system.unit.id}}
            <div class="item flex-horizontal" data-item-id="{{system.unit.id}}">
              <div class="item-body item-sheet-open flex-horizontal">
                <img src="{{system.unit.img}}" data-tooltip="{{system.unit.name}}" width="24" height="24"/>
                <div class="item-name">
                  <a data-action="openContact" data-target="{{syste.unit.id}}">
                    {{system.unit.name}}
                  </a>
                </div>
              </div>
              <a data-action="deleteUnit" data-tooltip="{{localize 'BITD.TitleDeleteItem'}}"><i class="fas fa-trash"></i></a>
            </div>
          {{/if}}
        </div>

      </section>

    </div>

  </section>

</div>
