<section class="flex-horizontal marginize-divs">
  <div class="flex-vertical grow-one">

    <label class="label-stripe">{{localize "SITS.AbilityPurchased"}}</label>
    <input id="ability-{{_id}}-purchased-value" type="text" name="system.purchased.value" value="{{system.purchased.value}}">

    <label class="label-stripe">{{localize "SITS.AbilityMaxPurchase"}}</label>
    <input id="ability-{{_id}}-purchased-max" type="text" name="system.purchased.max" value="{{system.purchased.max}}">

  </div>
  <div class="flex-vertical grow-one">

    <label class="label-stripe">{{localize "SITS.AbilityPlaybook"}}</label>
    <input id="ability-{{_id}}-playbook" type="text" name="system.playbook" value="{{system.playbook}}">

    <label class="label-stripe">{{localize "SITS.UseTargetField"}} &mdash; {{localize "SITS.Target"}}</label>
    <div class="flex-horizontal">
      <input id="ability-{{_id}}-use-target" type="checkbox" name="system.use_target" {{checked system.use_target}}>
      <input id="ability-{{_id}}-target" type="text" name="system.target" value="{{system.target}}">
    </div>
  </div>
</section>
