<section class="flex-horizontal marginize-divs">
  <div class="flex-vertical grow-one">

    <label class="label-stripe">{{localize "SITS.ItemCapacity"}}</label>
    <input id="item-{{_id}}-purchased-value" type="text" name="system.capacity" value="{{system.capacity}}">

    <label class="label-stripe">{{localize "SITS.ItemInPlay"}}</label>
    <div class="flex-horizontal-center centerline">
      <input id="item-{{_id}}-use-target" type="checkbox" name="system.inplay" {{checked system.inplay}}>
      {{localize "SITS.ItemInPlay"}}
    </div>

  </div>
  <div class="flex-vertical grow-one">

    <label class="label-stripe">{{localize "SITS.ItemPlaybook"}}</label>
    <input id="item-{{_id}}-playbook" type="text" name="system.playbook" value="{{system.playbook}}">

    <label class="label-stripe">{{localize "SITS.ItemCategory"}}</label>
    <input id="item-{{_id}}-category" type="text" name="system.category" value="{{system.category}}">
    
  </div>
</section>